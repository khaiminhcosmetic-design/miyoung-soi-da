# Sao chép file này thành .env và điền giá trị thật trước khi chạy.
# Không commit file .env vào git.

# Cổng chạy máy chủ
PORT=3000

# Môi trường: development | production
NODE_ENV=development

# Tên miền của trang soi da (dùng cho CORS và cookie).
# Ví dụ production: https://soida.miyoung.vn
SITE_ORIGIN=http://localhost:3000

# Khóa bí mật cho phiên đăng nhập quản trị - đổi sang chuỗi ngẫu nhiên dài khi triển khai thật.
# Có thể tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=doi-chuoi-nay-truoc-khi-chay-that

# Đường dẫn file cơ sở dữ liệu SQLite
DB_PATH=./data/soida.db

# Đường dẫn thư mục lưu file PDF cẩm nang 3 nhánh A/B/C (do quản trị viên tải lên)
CAM_NANG_DIR=./cam_nang

# Tài khoản quản trị viên khởi tạo lần đầu (chỉ dùng khi database chưa có tài khoản nào).
SEED_ADMIN_EMAIL=admin@miyoung.vn
SEED_ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# Phiên bản thông báo xử lý dữ liệu cá nhân hiện hành (tăng số khi sửa nội dung thông báo)
NOTICE_VERSION=TB-DLCN-SOIDA v1.2 (24/09/2026)

# Thư mục lưu bản sao lưu cơ sở dữ liệu đã mã hóa (mục 11.4) - nên trỏ ra ổ đĩa/khối lưu trữ riêng tại Việt Nam
BACKUP_DIR=./data/backups

# Khóa mã hóa bản sao lưu (32 byte, dạng hex = 64 ký tự). Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=
